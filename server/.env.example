MONGO_URI=your_mongo_uri
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=development

# CORS Allowed Origins
# Primary production frontend URL (e.g. https://lostfound.yourcollege.edu or https://campus-lostfound.vercel.app)
FRONTEND_URL=https://your-app-domain.com

# Optional: Comma-separated list of additional specific origins (e.g., approved staging or specific preview deployment)
ADDITIONAL_ALLOWED_ORIGINS=https://staging.your-app-domain.com

# Optional: Local development overrides (defaults to http://localhost:5173 and http://localhost:5174 in non-production)
LOCAL_FRONTEND_URL_1=http://localhost:5173
LOCAL_FRONTEND_URL_2=http://localhost:5174

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Email Delivery Configuration (Nodemailer / SMTP)
# In development, leaving these empty safely logs verification links to the local console.
# In production, provide verified SMTP credentials (e.g., Mailgun, SendGrid, Amazon SES, or university SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Campus Lost & Found" <noreply@campus.edu>
